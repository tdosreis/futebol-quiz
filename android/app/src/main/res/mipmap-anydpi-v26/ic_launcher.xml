<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawn by tools/make_icons.py from icons/icon-source.png — regenerate there,
    not here.

    Bubblewrap's default laid the whole square icon into the background layer
    and left the foreground empty. That works, but it hands the launcher a flat
    picture: there is nothing to separate from the background for parallax, and
    nothing for Android 13's themed icons to recolour, so those showed the green
    square untouched among everyone else's tinted glyphs. Here the green is the
    background, the question mark is the foreground, and the monochrome layer is
    the same question mark for themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
